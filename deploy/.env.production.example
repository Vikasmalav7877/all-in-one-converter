NODE_ENV=production
PORT=3000
QUEUE_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
CONVERSION_QUEUE_NAME=conversion-jobs
WORKER_CONCURRENCY=10
QUEUE_MAX_IN_FLIGHT=1000
RATE_LIMIT_PER_MINUTE=300

# OCR mode: auto | cloud-first
OCR_MODE=cloud-first

# Optional: required only when using cloud-first OCR with Google Vision
GOOGLE_VISION_API_KEY=replace_with_real_key
