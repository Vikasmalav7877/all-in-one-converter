{
  "name": "fileforge-converter",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "worker": "node worker.js",
    "dev": "nodemon server.js",
    "server:start-safe": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-server.ps1",
    "server:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-server.ps1",
    "server:status": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/server-status.ps1",
    "test:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/conversion-smoke.ps1",
    "prod:start": "npx pm2 start ecosystem.config.cjs --env production",
    "prod:restart": "npx pm2 restart fileforge-converter",
    "prod:stop": "npx pm2 stop fileforge-converter",
    "prod:status": "npx pm2 status",
    "prod:logs": "npx pm2 logs fileforge-converter --lines 200",
    "prod:start:api": "npx pm2 start ecosystem.config.cjs --only fileforge-converter --env production",
    "prod:start:worker": "npx pm2 start ecosystem.config.cjs --only fileforge-worker --env production"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "bullmq": "^5.76.2",
    "docx": "^9.5.1",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "mammoth": "^1.9.1",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.17.2",
    "sharp": "^0.34.2",
    "tesseract.js": "^6.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
